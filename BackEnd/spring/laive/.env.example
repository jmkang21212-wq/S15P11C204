# .env 파일에 이 파일 내용을 복사한 후 임시 값을 수정해주세요.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# pgAdmin 로그인 용 이메일, 비밀번호.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-to-another-long-random-password

# 네이버 로그인 OAuth 2.0 (서비스 로그인)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/naver/callback

# CHZZK Open API (방송 플랫폼 연동)
# 치지직 개발자센터에 등록한 값. redirect-uri는 등록한 로그인 리디렉션 URL과 완전히 일치해야 한다.
CHZZK_CLIENT_ID=your-chzzk-client-id
CHZZK_CLIENT_SECRET=your-chzzk-client-secret
CHZZK_REDIRECT_URI=http://localhost:8080/api/v1/platform-accounts/chzzk/callback

# 플랫폼 토큰 암호화 키(NFR-S-03). Base64로 인코딩한 32바이트 랜덤 값.
#   openssl rand -base64 32
PLATFORM_TOKEN_KEY=change-me-to-a-base64-encoded-32-byte-key

# OAuth 완료 후 돌려보낼 클라이언트 주소 목록. 쉼표로 구분하며, 요청받은 값과
# 완전히 일치하는 것만 허용한다(부분 일치·와일드카드 없음).
# 프론트(electron-vite) 개발 서버의 기본 포트인 5173에 맞춰져 있다.
OAUTH_ALLOWED_RETURN_URIS=http://localhost:5173/oauth/callback

# 개발용 로그인(POST /api/v1/auth/dev/login). 네이버 인증 없이 고정 개발 계정으로
# Refresh Token 쿠키를 발급한다. 로컬 개발에서만 true로 두고 배포 환경에서는 절대 켜지 않는다.
DEV_LOGIN_ENABLED=false

# Access Token 서명 키. 최소 32바이트 랜덤 값을 쓴다(HS256 최소 강도).
# 실제 비밀값은 절대 커밋하지 말 것.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# API를 HTTPS로 제공할 때 true로 둔다. Refresh Token 쿠키의 Secure 속성이다.
AUTH_COOKIE_SECURE=false

# 내부 수집·AI API(/internal/**) 서비스 토큰 (API 명세 13.1).
# 비워두면 /internal/** 요청이 전부 401로 거부된다. 수집기의 SPRING_TOKEN과 같은 값이어야 한다.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-secret-of-at-least-32-bytes

# 치지직 채팅 수집기 제어 서비스(AI/chat-collector). 비워두면 수집기를 연결하지 않는다.
COLLECTOR_BASE_URL=http://127.0.0.1:8002
# 수집기의 COLLECTOR_CONTROL_TOKEN과 같은 값이어야 한다.
COLLECTOR_CONTROL_TOKEN=change-me-to-another-random-secret

# 채팅 감정 분류 AI 서버(AI/chat-ai, 계약: AI/CHAT_AI_API.md).
# 비워두면 AI를 연결하지 않고 채팅은 sentiment_label 없이 저장된다.
CHATAI_BASE_URL=http://127.0.0.1:8001
# chat-ai 서버의 CHATAI_TOKEN과 같은 값이어야 한다. 양쪽 다 비우면 검사하지 않는다(로컬 전용).
CHATAI_TOKEN=change-me-to-yet-another-random-secret

# 방송 종료 세션 리포트용 Spring AI. 비활성화하면 서버는 정상 기동하지만
# 비동기 리포트 AI 작업은 재시도 후 PARTIAL로 종료된다.
REPORT_AI_ENABLED=false
# 활성화할 때 Spring AI ChatModel 자동 구성을 openai로 지정한다.
REPORT_AI_MODEL_ENABLED=openai
REPORT_AI_API_KEY=your-openai-compatible-api-key(GMS)
REPORT_AI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
REPORT_AI_MODEL=gpt-4.1-mini
# gpt-5 계열(추론 모델)은 1만 허용한다. 모델을 gpt-5로 되돌리면 이 값도 1로 바꿔야 400이 안 난다.
REPORT_AI_TEMPERATURE=0.2

# 성장 목표에 맞는 AI 액션 생성. 세션 리포트와 동일한 ChatModel 설정을 공유한다.
GROWTH_AI_ENABLED=false
GROWTH_AI_PROMPT_VERSION=growth-action-v1

# 포트폴리오·성장/세션 리포트를 바탕으로 최초 추천 목표 3개를 생성한다.
# 생략하면 GROWTH_AI_ENABLED 값을 따르며 같은 Spring AI ChatModel을 공유한다.
GROWTH_ROADMAP_AI_ENABLED=false
GROWTH_ROADMAP_AI_PROMPT_VERSION=growth-roadmap-v1

# CHAT_SURGE 하이라이트 판정 파라미터 튜닝(HIGHLIGHT_*)은 .env.highlight.example 참고.
# 필요한 키만 주석을 풀어 .env에 복사하면 재배포 없이 조정된다.
