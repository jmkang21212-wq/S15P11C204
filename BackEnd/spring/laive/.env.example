# .env 파일에 이 파일 내용을 복사한 후 임시 값을 수정해주세요.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# pgAdmin 로그인 용 이메일, 비밀번호.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-to-another-long-random-password

# Naver Login OAuth 2.0
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/naver/callback

# CHZZK Open API (방송 플랫폼 연동)
# 치지직 개발자센터에 등록한 값. redirect-uri는 등록한 로그인 리디렉션 URL과 완전히 일치해야 한다.
CHZZK_CLIENT_ID=your-chzzk-client-id
CHZZK_CLIENT_SECRET=your-chzzk-client-secret
CHZZK_REDIRECT_URI=http://localhost:8080/api/v1/platform-accounts/chzzk/callback

# 플랫폼 토큰 암호화 키(NFR-S-03). Base64로 인코딩한 32바이트 랜덤 값.
#   openssl rand -base64 32
PLATFORM_TOKEN_KEY=change-me-to-a-base64-encoded-32-byte-key

# Comma-separated exact callback URLs accepted from the client.
OAUTH_ALLOWED_RETURN_URIS=http://localhost:3000/oauth/callback

# Use a random value of at least 32 bytes. Never commit the real secret.
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# Set true when the API is served over HTTPS.
AUTH_COOKIE_SECURE=false

# 내부 수집·AI API(/internal/**) 서비스 토큰 (API 명세 13.1).
# 비워두면 /internal/** 요청이 전부 401로 거부된다. 수집기의 SPRING_TOKEN과 같은 값이어야 한다.
INTERNAL_SERVICE_TOKEN=change-me-to-a-random-secret-of-at-least-32-bytes

# 치지직 채팅 수집기 제어 서비스(AI/collector). 비워두면 수집기를 연결하지 않는다.
COLLECTOR_BASE_URL=http://127.0.0.1:8002
# 수집기의 COLLECTOR_CONTROL_TOKEN과 같은 값이어야 한다.
COLLECTOR_CONTROL_TOKEN=change-me-to-another-random-secret
