# CHAT_SURGE 하이라이트 판정 파라미터 오버라이드 (알고리즘: AI/chat-ai/HIGHLIGHT_SPEC.md).
# 기본값은 application.yaml에 있고 전부 백테스트 미검증이라 튜닝 전제다.
# 필요한 키만 주석을 풀어 .env에 복사하면 재배포 없이 조정된다.
#
# 판정 원리 한 줄 요약: "최근 1분 안에 채팅 친 사람의 비율"이 그 방송의 평소
# 수준보다 눈에 띄게 높은 상태가 몇 초 이상 이어지면 하이라이트 구간으로 본다.

# "채팅 친 사람 비율"을 셀 때 되돌아보는 시간. 늘리면 둔감하고 안정적, 줄이면 민감하지만 노이즈에 흔들린다.
#HIGHLIGHT_ENGAGE_WINDOW=60s

# "평소 수준"을 기억하는 길이(1초 틱 개수). 900 = 최근 15분의 기록으로 평소를 정의한다.
#HIGHLIGHT_BASELINE_SIZE=900

# 진입 문턱: 평소 대비 얼마나 튀어야 "달아올랐다"고 볼지 점수(z). 대략 "평소 오르내림 폭의 3배".
# 올리면 진짜 하이라이트를 놓치고, 내리면 오탐이 는다.
#HIGHLIGHT_Z_ENTER=3.0

# 튄 상태가 몇 초(틱) 연속이어야 진입 확정인지. 한 번 반짝하는 스파이크 오탐을 거른다.
#HIGHLIGHT_ENTER_TICKS=3

# 이탈 문턱: 이 점수까지 식어야 "끝났다"고 본다. 에어컨이 26도에 켜지고 24도에 꺼지듯
# 진입(3.0)보다 낮게 둬야 경계에서 구간이 잘게 쪼개지지 않는다.
#HIGHLIGHT_Z_EXIT=1.5

# 식은 상태가 몇 초 연속이어야 종료 확정인지. 채팅이 아예 끊긴 틱(저활동)도 여기에 산입된다.
#HIGHLIGHT_EXIT_TICKS=8

# 구간 확정 시 시작점을 이만큼 앞으로 당긴다 — 채팅 반응은 원인이 된 장면보다 늦게 온다.
#HIGHLIGHT_LEAD=30s

# 한 구간의 최대 길이. 이걸 넘기면 강제로 끊는다.
# 주의: LEAD 포함 300초를 넘기면 리포트 하이라이트 자격에서 탈락한다(4m + 30s = 270s로 여유 확보).
#HIGHLIGHT_MAX_ACTIVE=4m

# 구간 확정 직후 판정을 쉬는 시간. 짧게 두면 하나의 하이라이트가 여러 개로 쪼개진다.
#HIGHLIGHT_COOLDOWN=30s

# 방송 시작 후 판정을 쉬는 시간 — "안녕하세요" 인사 러시가 매번 하이라이트로 잡히는 것 방지.
#HIGHLIGHT_WARMUP=3m

# 워밍업 중에도 "평소 수준"(baseline)을 쌓을지. 기본 true — 워밍업의 원래 목적이
# baseline 채우기다. false면 워밍업 표본을 버리고 워밍업 안에 받은 채팅을 판정
# 윈도우에서도 빼서, 시작 인사 러시가 평소 수준을 선점하지 못한다(러시가 초기
# baseline의 다수를 차지하는 짧은 시연에서 유효). 워밍업이 끝나면 baseline이
# 조용한 표본으로 시드될 몇 초만 지나면 바로 급증 판정이 가능하다.
# 대신 판정이 거의 빈 baseline으로 시작하므로 운영에서는 true를 권장.
#HIGHLIGHT_BASELINE_DURING_WARMUP=true

# 최근 1분 채팅이 이보다 적으면 그 틱은 판정을 쉰다 — 채팅 몇 건으로 낸 비율은 믿을 수 없다.
#HIGHLIGHT_MIN_WINDOW_CHATS=4

# "평소 변동 폭"이 0으로 계산돼 나눗셈이 깨지는 것을 막는 최소값(안전망). 보통 만질 일 없다.
#HIGHLIGHT_MAD_EPSILON=0.001

# 진입 문턱을 "사람 수"로 잡아주는 값. 0.5면 채널 규모와 무관하게
# "평소보다 채터 약 +2~3명"이 진입 조건이 된다.
# 올리면 소규모 채널이 둔감해지고, 내리면 조용한 채널에서 2명 대화도 잡힐 수 있다.
#HIGHLIGHT_MAD_FLOOR_CHATTERS=0.5

# 판정 로그 레벨. INFO면 상태 전이·구간 확정만(방송당 몇 줄), DEBUG면 매 틱의
# (ts, engagement, z, phase)까지 — 명세가 튜닝 근거로 강권하는 로그다.
#HIGHLIGHT_LOG_LEVEL=INFO

# ── 시연(데모) 프리셋: 5분 시연용 프로필 ─────────────────────────
# 목표: 소수 인원 테스트 방송에서 하이라이트 2~3개가 확실히 잡히게 한다.
# 아래 블록 전체를 .env에 복사하고, 시연 각본(하단)을 따른다.
# 시연이 끝나면 블록을 지우면 운영 기본값으로 돌아간다.
#
# 근거:
#  - WARMUP 30s        : 3분 기다릴 필요 없이 판정을 빨리 연다
#  - BASELINE_DURING_WARMUP false : 워밍업 표본을 baseline·판정 윈도우 양쪽에서 제외 —
#                        시작 인사 러시가 "평소 수준"을 선점하지 못한다. 인사만 워밍업
#                        (30초) 안에 끝나면 채팅 금지 규칙 없이 baseline이 깨끗하게
#                        시작되고, 워밍업 종료 ~10초 뒤부터 바로 버스트를 걸 수 있다
#  - ENGAGE_WINDOW 30s : 반응을 빠르게, 채팅이 멎은 뒤 구간이 닫히는 것도 빠르게
#  - Z_ENTER 2.0       : 조용한 baseline 기준 새 유니크 채터 2명(z≈2.7)이면 진입,
#                        1명(z≈1.35)은 걸러진다 (필요 초과분 ≈ Z_ENTER × 1.4826 × MAD_FLOOR 0.5)
#  - ENTER_TICKS 2     : 급증 2초 연속이면 진입 — 순간 스파이크 오탐 위험은 시연에서 무시
#  - MIN_WINDOW_CHATS 3: 윈도우 채팅 3건이면 판정 참여 — 2명이 한두 마디씩이면 충족
#  - EXIT_TICKS 5      : 채팅을 멈추면 ~5초 만에 구간이 확정돼 화면·로그에 바로 뜬다
#  - LEAD 10s          : 5분 시연에서 30초 소급은 구간이 과하게 길어 보인다
#  - MAX_ACTIVE 60s    : 구간이 짧게 끊겨야 시연 화면에서 여러 개가 구분돼 보인다.
#                        ACTIVE 진입만 하면 늦어도 60초 뒤 강제 확정 — 구간 1개는 보장된다
#  - COOLDOWN 15s      : 확정 후 15초만 쉬고 다음 판정
#  - LOG DEBUG         : 서버 로그에서 매초 (engagement, z, phase)를 눈으로 확인
#
#HIGHLIGHT_WARMUP=30s
#HIGHLIGHT_BASELINE_DURING_WARMUP=false
#HIGHLIGHT_ENGAGE_WINDOW=30s
#HIGHLIGHT_Z_ENTER=2.0
#HIGHLIGHT_ENTER_TICKS=2
#HIGHLIGHT_MIN_WINDOW_CHATS=3
#HIGHLIGHT_EXIT_TICKS=5
#HIGHLIGHT_LEAD=10s
#HIGHLIGHT_MAX_ACTIVE=60s
#HIGHLIGHT_COOLDOWN=15s
#HIGHLIGHT_LOG_LEVEL=DEBUG

# 절대 보장이 필요할 때(비상용): 아래 두 줄로 바꾸면 새 채터 1명(z≈2.25)으로도
# 진입한다. 대신 워밍업 이후 아무나 말 걸 때마다 구간이 생겨 난립할 수 있다 —
# 기본은 위 프리셋 + 버스트 요원 3명 지정이다.
#HIGHLIGHT_Z_ENTER=1.5
#HIGHLIGHT_MAD_FLOOR_CHATTERS=0.3

# ── 시연 각본 (설정보다 이게 더 중요하다) ────────────────────────
# 판정은 "채팅이 많은가"가 아니라 "평소(최근 15분 median)보다 유니크 채터가
# 급증했는가"를 본다. 모두가 처음부터 계속 떠들면 baseline이 그 수준으로 올라가
# z ≈ 0이 되어 영영 안 잡힌다 — 하이라이트는 절대량이 아니라 '변화'다.
#
# 1. 인사는 워밍업(30초) 안에 끝낸다 — BASELINE_DURING_WARMUP=false라 워밍업 안의
#    채팅은 baseline에도 판정 윈도우에도 남지 않는다. 단 워밍업을 넘긴 채팅은
#    그대로 '평소'가 되어 이후 급증이 묻힌다. 워밍업이 끝나면 ~10초만 조용히 —
#    빈 baseline에 조용한 표본이 먼저 시드돼야 급증이 '변화'로 보인다.
#    콘솔 하이라이트 카드의 skipReason이 no-viewers로 떠 있으면 시청자 폴링이
#    죽어 판정 자체가 쉬고 있는 것이다 — z 이전에 이것부터 확인.
# 2. 신호에 맞춰 서로 다른 계정 3명 이상(최소 2명)이 30초 안에 채팅을 친다.
#    ⚠ 한 명이 도배하는 건 효과 없다 — 판정은 유니크 채터 수만 본다.
#    윈도우 채팅 3건(MIN_WINDOW_CHATS) 이상도 함께 채워야 판정 틱이 돈다.
# 3. 급증 후 채팅을 뚝 멈춘다 — EXIT_TICKS초 뒤 구간이 확정되고
#    서버 로그(CHAT_SURGE 트리거 확정)와 콘솔 하이라이트 카드에 반영된다.
#    계속 떠들어도 MAX_ACTIVE(60s)에 강제 확정되므로 구간은 반드시 남는다.
