# 빌드 컨텍스트에서 제외할 것.
# docker build는 이 폴더 전체를 Docker 데몬에 전송하므로, 막지 않으면
# 매 빌드마다 1.5GB 이상을 보내게 된다.

# 가상환경 — 컨테이너 안에서 새로 만든다 (799MB)
.venv/

# 모델 — 볼륨이나 BAKE_MODEL로 관리한다 (641MB).
# 여기서 제외해도 Dockerfile의 RUN fetch_model.py는 정상 동작한다.
# COPY를 막는 것이지 컨테이너 안에서 만드는 것을 막지 않는다.
**/models/

# 채팅 데이터 — uid·닉네임이 든 개인정보. 이미지에 절대 들어가면 안 된다
**/data/
**/*.jsonl
**/*.duckdb

# 로그 — 볼륨으로 마운트한다
logs/
**/*.log

# 비밀값 — 런타임에 env_file로 주입한다. 이미지에 굽지 않는다
.env

# 캐시·개발 도구
**/__pycache__/
**/*.pyc
.pytest_cache/
.vscode/
.git/
.gitignore

# 부하 테스트 도구 — 서버가 import하지 않는 독립 스크립트
AI/bench/
