GROQ_API_KEY=gsk_여기에_키를_붙여넣으세요
GMS_KEY=여기에_SSAFY_GMS_키를_붙여넣으세요

# Spring 서버 주소. 비워두면 전송을 하지 않는다(감지 기능은 정상 동작).
SPRING_BASE_URL=
# Spring의 INTERNAL_SERVICE_TOKEN과 같은 값이어야 한다(API 명세 13.1).
SPRING_TOKEN=

# --- 채팅 감정 분류 AI (chat-ai/) ---

# Spring이 chat-ai를 호출할 때 검사하는 토큰. Spring의 CHATAI_TOKEN과 같아야 한다.
# 비워두면 인증을 검사하지 않는다(로컬 개발용). GET /health는 항상 면제.
CHATAI_TOKEN=

# 윈도우 상태 저장용 Redis. 팀 Redis의 DB 1을 쓴다(Spring은 DB 0).
CHATAI_REDIS_URL=redis://127.0.0.1:6379/1

# --- 치지직 채팅 수집기 (chat-collector/) ---

# Spring이 수집기를 제어할 때 쓰는 토큰. Spring의 COLLECTOR_CONTROL_TOKEN과 같아야 한다.
# 비워두면 제어 API 인증을 검사하지 않는다(로컬 개발용).
COLLECTOR_CONTROL_TOKEN=

# YouTube Data API endpoint used by the multi-platform collector. Normally the
# default should remain unchanged; override only for an API-compatible proxy or test server.
YOUTUBE_API_BASE=https://www.googleapis.com

# 시청자 식별자 해시에 쓰는 고정 비밀값.
#
#   주의: 실데이터를 수집하기 전에 정하고, 그 뒤로 절대 바꾸지 말 것.
#   바꾸면 같은 시청자가 다른 해시로 보여 VIEWER_PROFILES에 중복 인격이 생기고
#   과거 데이터와 이어지지 않는다. 되돌릴 방법이 없다.
#
#   생성:  python -c "import secrets; print(secrets.token_hex(16))"
#
# 비워두면 소금 없이 SHA-256만 걸리는데, 치지직 채널 ID는 32자리 16진수라
# 전수 대조로 원본을 되찾을 수 있다. 운영에서는 반드시 채울 것.
COLLECTOR_VIEWER_HASH_SALT=

# --- 음성 AI WebSocket 접속 인증 (app/, 8000) ---
# Spring이 발급한 일회용 티켓을 조회할 Redis.
# ⚠ Spring이 쓰는 DB(기본 0)여야 한다. 채팅 감정 서버가 쓰는 DB 1이 아니다.
VOICE_REDIS_URL=redis://127.0.0.1:6379/0
# 1이면 티켓 없이도 접속을 허용한다. static/client.html 같은 개발 도구용이며
# 켜져 있으면 /health의 authBypass가 true로 보인다. 배포 환경에서는 절대 켜지 말 것.
VOICE_AUTH_DEV_BYPASS=0
