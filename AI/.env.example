# ============================================================
#  Spring과 짝을 맞춰야 하는 값
# ============================================================
#
#  AI 쪽 (이 파일)            Spring 쪽 (BackEnd/spring/laive/.env)
#  ─────────────────────────────────────────────────────────────
#  SPRING_TOKEN            =  INTERNAL_SERVICE_TOKEN     ← 이름 다름! 주의
#  CHATAI_TOKEN            =  CHATAI_TOKEN
#  COLLECTOR_CONTROL_TOKEN =  COLLECTOR_CONTROL_TOKEN
#
#  SPRING_BASE_URL         →  Spring이 떠 있는 주소
#  (chat-ai가 뜬 주소)      ←  CHATAI_BASE_URL
#  (수집기가 뜬 주소)        ←  COLLECTOR_BASE_URL
#
#  VOICE_REDIS_URL   DB 0  =  Spring과 '같은' DB   (인증 티켓을 공유해야 함)
#  CHATAI_REDIS_URL  DB 1  ≠  Spring과 '다른' DB   (키 충돌을 피해야 함)
#
#  토큰 3개는 양쪽 다 비우면 인증 검사를 하지 않는다(로컬 개발용).
#  한쪽만 채우면 전부 401이 난다 — 채울 거면 양쪽 같이 채울 것.
#
#  생성:  python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

GROQ_API_KEY=gsk_여기에_키를_붙여넣으세요
GMS_KEY=여기에_SSAFY_GMS_키를_붙여넣으세요

# Spring 서버 주소. 비워두면 전송을 하지 않는다(감지 기능은 정상 동작).
#   Docker 로컬 : http://host.docker.internal:8080   (Spring을 IDE로 띄울 때)
#   Docker 배포 : http://spring:8080                 (Spring도 컨테이너일 때)
#   맨손 실행   : http://127.0.0.1:8080
# 비워두면 compose가 'Docker 로컬' 값을 넣는다(compose.yaml 참고).
SPRING_BASE_URL=

# Spring의 INTERNAL_SERVICE_TOKEN과 '같은 값'이어야 한다(API 명세 13.1).
# ⚠ 변수 이름이 서로 다르다. 한쪽만 채우면 AI→Spring 전송이 전부 401로 막힌다.
SPRING_TOKEN=

# --- 채팅 감정 분류 AI (chat-ai/) ---

# Spring이 chat-ai를 호출할 때 검사하는 토큰. Spring의 CHATAI_TOKEN과 같아야 한다.
# 한쪽만 채우면 Spring→AI 호출이 401. 양쪽 다 비우면 검사하지 않는다(로컬 개발용).
# GET /health는 항상 면제.
CHATAI_TOKEN=

# 윈도우 상태 저장용 Redis.
# ⚠ Spring이 쓰는 DB(기본 0)와 '달라야' 한다 — 같은 DB를 쓰면 키가 충돌한다.
#   Docker    : redis://redis:6379/1        (compose가 넣어준다)
#   맨손 실행 : redis://127.0.0.1:6379/1
CHATAI_REDIS_URL=redis://127.0.0.1:6379/1

# --- 치지직 채팅 수집기 (chat-collector/) ---

# Spring이 수집기를 제어할 때 쓰는 토큰. Spring의 COLLECTOR_CONTROL_TOKEN과 같아야 한다.
# 비워두면 제어 API 인증을 검사하지 않는다(로컬 개발용).
COLLECTOR_CONTROL_TOKEN=

# 시청자 식별자 해시에 쓰는 고정 비밀값.
#
#   주의: 실데이터를 수집하기 전에 정하고, 그 뒤로 절대 바꾸지 말 것.
#   바꾸면 같은 시청자가 다른 해시로 보여 VIEWER_PROFILES에 중복 인격이 생기고
#   과거 데이터와 이어지지 않는다. 되돌릴 방법이 없다.
#
#   생성:  python -c "import secrets; print(secrets.token_hex(16))"
#
# 비워두면 소금 없이 SHA-256만 걸리는데, 치지직 채널 ID는 32자리 16진수라
# 전수 대조로 원본을 되찾을 수 있다. 운영에서는 반드시 채울 것.
COLLECTOR_VIEWER_HASH_SALT=

# --- 음성 AI WebSocket 접속 인증 (app/, 8000) ---

# Spring이 발급한 일회용 티켓을 조회할 Redis.
# ⚠ Spring이 쓰는 DB(기본 0)와 '같아야' 한다 — 티켓을 공유해야 하기 때문이다.
#    위 CHATAI_REDIS_URL(DB 1)과 반대다. 통일하지 말 것.
#   Docker    : redis://redis:6379/0        (compose가 넣어준다)
#   맨손 실행 : redis://127.0.0.1:6379/0
VOICE_REDIS_URL=redis://127.0.0.1:6379/0

# 1이면 티켓 없이도 접속을 허용한다. static/client.html 같은 개발 도구용이며
# 켜져 있으면 /health의 authBypass가 true로 보인다. 배포 환경에서는 절대 켜지 말 것.
VOICE_AUTH_DEV_BYPASS=0
