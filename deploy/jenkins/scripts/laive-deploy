#!/usr/bin/env bash
set -Eeuo pipefail

readonly REPOSITORY=/home/ubuntu/laive
readonly SPRING_COMPOSE="$REPOSITORY/BackEnd/spring/laive/compose.yaml"
readonly AI_COMPOSE="$REPOSITORY/AI/compose.yaml"
readonly DEPLOY_LOCK=/home/ubuntu/.laive-deploy.lock

exec 9>"$DEPLOY_LOCK"
flock -n 9 || {
  echo "Another LAIVE deployment is already running."
  exit 1
}

cd "$REPOSITORY"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Refusing to deploy because the production worktree has local changes."
  exit 1
fi

previous_revision="$(git rev-parse HEAD)"

deploy_revision() {
  local revision="$1"

  git checkout --detach "$revision"

  docker compose \
    --project-directory "$REPOSITORY/BackEnd/spring/laive" \
    -f "$SPRING_COMPOSE" \
    build spring
  docker compose \
    --project-directory "$REPOSITORY/BackEnd/spring/laive" \
    -f "$SPRING_COMPOSE" \
    up -d --no-deps spring

  docker compose \
    --project-directory "$REPOSITORY/AI" \
    -f "$AI_COMPOSE" \
    build voice chat-ai collector
  docker compose \
    --project-directory "$REPOSITORY/AI" \
    -f "$AI_COMPOSE" \
    up -d --no-deps voice chat-ai collector
}

wait_for_healthy() {
  local container
  local status
  local attempt

  for container in laive-spring laive-voice laive-chat-ai laive-collector; do
    for attempt in $(seq 1 60); do
      status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null || true)"
      if [[ "$status" == "healthy" ]]; then
        echo "$container is healthy."
        break
      fi
      if [[ "$status" == "unhealthy" || "$status" == "exited" || "$attempt" -eq 60 ]]; then
        echo "$container failed its health check (status: ${status:-missing})."
        return 1
      fi
      sleep 5
    done
  done
}

rollback() {
  trap - ERR
  echo "Deployment failed; rolling back to $previous_revision."
  deploy_revision "$previous_revision"
  wait_for_healthy
}

trap rollback ERR

git fetch --prune origin master
target_revision="$(git rev-parse origin/master)"

if [[ "$target_revision" == "$previous_revision" ]]; then
  echo "Production is already at $target_revision."
  exit 0
fi

echo "Deploying $target_revision (previous: $previous_revision)."
deploy_revision "$target_revision"
wait_for_healthy
trap - ERR

echo "Deployment completed successfully: $target_revision"
